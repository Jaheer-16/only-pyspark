STEP3:

CREATE OR REPLACE TEMP VIEW staging_employee AS
SELECT * FROM VALUES
(2, 'Alice', 'Bangalore'),
(4, 'Sam', 'Chennai')
AS staging(employeeid,empname,city);

STEP 4:

DETECTING RECORDS WHICH ARE OUTDATED

MERGE INTO dim_employee AS tgt
USING staging_employee AS src
ON tgt.employeeid=src.employeeid
AND tgt.is_active='Y'

WHEN MATCHED AND (tgt.city<>src.city OR tgt.empname<>src.empname)
THEN UPDATE 
SET
tgt.end_date=Current_date(),
tgt.is_active='N';


INSERT INTO dim_employee 
SELECT
 src.employeeid,
 src.empname,
 src.city,
 current_date() AS start_date,
 NULL AS end_date,
 'Y' AS is_active
 FROM
 staging_employee src
 LEFT JOIN dim_employee AS tgt
 ON src.employeeid=tgt.employeeid
 AND tgt.is_active='Y'
 WHERE tgt.employeeid IS NULL;
 
 
 
 OR
 
 WHEN NOT MATCHED
THEN INSERT (
  emp_id,
  name,
  city,
  start_date,
  end_date,
  is_active
)
VALUES (
  src.emp_id,
  src.name,
  src.city,
  current_date(),
  NULL,
  'Y'
);
